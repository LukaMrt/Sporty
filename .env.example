TZ=UTC
PORT=3333
# localhost en dev : 0.0.0.0 exposerait le serveur (et Vite) à tout le réseau local
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development
APP_NAME=Sporty
VITE_APP_NAME=Sporty

# Racine du stockage des fichiers (GPX). Défaut : ./storage
# En Docker : /app/storage (monté en volume)
# STORAGE_PATH=

# Planificateur de synchronisation des connecteurs (désactivé automatiquement en test)
# SCHEDULER_ENABLED=true

# Generate a new key for production: node ace generate:key
APP_KEY=aazeaze78az1dqs5d47a65zd1qsd47

# =============================================================================
# PostgreSQL database
# Default values for local development.
#
# To override without versioning: create a .env.local file
# (already ignored by git). Example: DB_HOST=localhost DB_PORT=5433
#
# Note: when the app runs inside Docker (docker compose up app),
#       DB_HOST is automatically overridden to "db" (service name).
#       When running locally (node ace serve --hmr),
#       DB_HOST must be "localhost".
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=sporty
DB_PASSWORD=sporty
DB_DATABASE=sporty

# =============================================================================
# Connector token encryption (AES-256-GCM)
# Generate a real key for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
CONNECTOR_ENCRYPTION_KEY=demo-key-change-in-production-32b

# =============================================================================
# Strava OAuth connector
# Register your app at https://www.strava.com/settings/api
# APP_URL is used to build the redirect_uri (default: http://HOST:PORT)
# =============================================================================
APP_URL=http://localhost:3333
STRAVA_CLIENT_ID=strava-client-id-change-me-in-production
STRAVA_CLIENT_SECRET=strava-client-secret-change-me-in-production
# Connecteur open-wearables (la cle API est saisie par utilisateur dans l'UI)
OPEN_WEARABLES_BASE_URL=https://wearables-api.change-me.example/api/v1
OPEN_WEARABLES_API_KEY_HEADER=X-Open-Wearables-API-Key
