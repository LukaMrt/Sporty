# Dependencies (re-installed in Docker)
node_modules

# Build output (rebuilt in Docker)
build

# Version control
.git
.gitignore
.github

# BMAD workflow files
_bmad*
_bmad-output
.claude

# Environment overrides (ne jamais inclure dans l'image)
.env
.env.local
.env.test
.env.development.local
.env.production.local

# Données utilisateurs (GPX…) : jamais dans le contexte de build
storage

# Rapports de tests et de couverture
coverage
playwright-report
test-results
tests/e2e/.auth

# TypeScript incremental build info
*.tsbuildinfo

# Editor configs
.vscode
.idea
.fleet
.editorconfig

# OS files
.DS_Store

# Logs
npm-debug.log
yarn-error.log

# Temporary files
tmp

# Frontend compiled assets (rebuilt in Docker via pnpm build)
public/assets

# Documentation
docs
*.md
