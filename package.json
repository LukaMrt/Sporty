{
  "name": "sporty",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "node bin/server.js",
    "preview": "node ace build && cd build && NODE_ENV=production node --env-file=../.env --env-file-if-exists=../.env.local bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "c8 node ace test --force-exit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p inertia/tsconfig.json",
    "depcruise": "depcruise app --config .dependency-cruiser.cjs",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run depcruise && pnpm run test && pnpm run test:front",
    "db:migrate": "node ace migration:run",
    "db:migrate:rollback": "node ace migration:rollback",
    "db:migrate:fresh": "node ace migration:fresh",
    "db:seed": "node ace db:truncate && node ace db:seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:front": "vitest run"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#use_cases/*": "./app/use_cases/*.js",
    "#domain/*": "./app/domain/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#connectors/*": "./app/connectors/*.js",
    "#lib/*": "./app/lib/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "~8.5.2",
    "@adonisjs/eslint-config": "~3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "~2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "~5.2.0",
    "@japa/runner": "~5.3.0",
    "@playwright/test": "^1.63.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "c8": "~12.0.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "~10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "hot-hook": "~1.0.0",
    "jsdom": "^30.1.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "~8.3.1",
    "vitest": "^5.0.1",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "~10.1.0",
    "@adonisjs/core": "~7.5.2",
    "@adonisjs/cors": "~3.0.0",
    "@adonisjs/i18n": "~3.0.1",
    "@adonisjs/inertia": "~5.0.1",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "~22.4.2",
    "@adonisjs/session": "~8.1.0",
    "@adonisjs/shield": "~9.0.0",
    "@adonisjs/static": "~2.0.1",
    "@adonisjs/vite": "~6.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@inertiajs/react": "^3.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tanstack/react-table": "^9.2.4",
    "@vinejs/vine": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "edge.js": "^6.5.1",
    "fast-xml-parser": "^5.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "~1.48.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.7.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "c8": {
    "reporter": [
      "html",
      "text-summary",
      "lcov"
    ],
    "include": [
      "app/**"
    ],
    "extension": [
      ".ts",
      ".js"
    ],
    "all": true,
    "reportsDirectory": "coverage",
    "check-coverage": true,
    "lines": 60,
    "functions": 60,
    "branches": 50
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
