{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    { "groupName": "adonisjs", "matchPackageNames": ["@adonisjs/**", "@japa/**"] },
    { "groupName": "react", "matchPackageNames": ["react", "react-dom", "@types/react*"] },
    { "groupName": "types", "matchPackageNames": ["@types/**"] },
    {
      "groupName": "lint & format",
      "matchPackageNames": ["eslint", "prettier", "typescript-eslint", "prettier-plugin-*"]
    },
    {
      "description": "TypeScript 7 bloqué tant que typescript-eslint ne le supporte pas",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
